#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="$basedir/D:/code/2023/project-zhyl-admin-vue3-java/node_modules/.store/stylelint@13.13.1/node_modules"
else
  export NODE_PATH="$NODE_PATH:$basedir/D:/code/2023/project-zhyl-admin-vue3-java/node_modules/.store/stylelint@13.13.1/node_modules"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../stylelint@13.13.1/node_modules/stylelint/bin/stylelint.js" "$@"
else
  exec node  "$basedir/../../../../../stylelint@13.13.1/node_modules/stylelint/bin/stylelint.js" "$@"
fi
